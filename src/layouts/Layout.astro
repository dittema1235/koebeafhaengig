---
import '../styles/global.css';
import { u } from '../lib/base';
interface Props { title: string; description?: string; canonical?: string; type?: string; popup?: boolean; }
const { title, description = 'Få hjælp til købeafhængighed og overforbrug med psykolog Ditte Munch-Andersen. Onlineforløb og individuelle samtaler.', canonical = Astro.url.pathname, type = 'website', popup = true } = Astro.props;
const canonicalUrl = new URL(canonical, 'https://www.koebeafhaengig.dk').toString();
const fullTitle = title.includes('koebeafhaengig.dk') ? title : `${title} | koebeafhaengig.dk`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://www.koebeafhaengig.dk/#organization', name: 'koebeafhaengig.dk', url: 'https://www.koebeafhaengig.dk', email: 'psykolog@dittemunchandersen.dk', founder: { '@id': 'https://www.koebeafhaengig.dk/om-ditte#person' } },
    { '@type': 'Person', '@id': 'https://www.koebeafhaengig.dk/om-ditte#person', name: 'Ditte Munch-Andersen', jobTitle: 'Klinisk psykolog', url: 'https://www.koebeafhaengig.dk/om-ditte' },
    { '@type': 'WebSite', '@id': 'https://www.koebeafhaengig.dk/#website', url: 'https://www.koebeafhaengig.dk', name: 'Slip din købetrang', inLanguage: 'da-DK' }
  ]
};
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f8f5ee" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="koebeafhaengig.dk" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.koebeafhaengig.dk/billeder/ditte.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" id="silktide-consent-manager-css" href="https://cdn.jsdelivr.net/gh/silktide/consent-manager@v2.0.1/silktide-consent-manager.css" integrity="sha384-EdMq+R+YOnsbelo08wPenoTlnxbAyxI11NMIxzugx/qAsbh64KcOkqxYqq6pfvO/" crossorigin="anonymous" />
    <script is:inline src="https://cdn.jsdelivr.net/gh/silktide/consent-manager@v2.0.1/silktide-consent-manager.js" integrity="sha384-5Pt34uiIbCsvfiiZXoLi4HRf/YBXjr9c8e+gYeVo9smUaInNHYVtc8NZ8wUnXJIq" crossorigin="anonymous"></script>
    <style is:inline>
      #stcm-wrapper {
        --fontFamily: 'DM Sans', system-ui, sans-serif;
        --primaryColor: #20372f;
        --backgroundColor: #fffdf8;
        --textColor: #20372f;
        --iconColor: #20372f;
        --iconBackgroundColor: #fffdf8;
      }
    </style>
    <script is:inline define:vars={{ popup }}>
      window.silktideConsentManager.init({
        prompt: { position: 'bottomRight' },
        icon: { position: 'bottomLeft' },
        backdrop: { show: false },
        consentTypes: [
          {
            id: 'essential',
            label: 'Nødvendige',
            description: '<p>Gør, at siden kan fungere. Kan ikke slås fra.</p>',
            required: true
          },
          {
            id: 'newsletter',
            label: 'Nyhedsbrev',
            description: '<p>Viser tilmeldingen til nyhedsbrevet. Formularen leveres af systeme.io, og vi gemmer en lille cookie, så den ikke dukker op igen, når du har lukket den eller meldt dig til.</p>',
            defaultValue: false,
            ...(popup ? { scripts: [{ url: 'https://dittemunchandersen.systeme.io/public/remote/page/464870447522a253bb3e15071f424dffe7912eda.js' }] } : {})
          }
        ],
        text: {
          prompt: {
            description: '<p>Må vi vise tilmeldingen til nyhedsbrevet? Den leveres af systeme.io. Siger du nej, bruger vi kun det, siden skal bruge for at virke.</p>',
            acceptAllButtonText: 'Ja tak',
            acceptAllButtonAccessibleLabel: 'Accepter alle cookies',
            rejectNonEssentialButtonText: 'Nej tak',
            rejectNonEssentialButtonAccessibleLabel: 'Afvis alle ikke-nødvendige cookies',
            preferencesButtonText: 'Indstillinger',
            preferencesButtonAccessibleLabel: 'Administrer cookieindstillinger'
          },
          preferences: {
            title: 'Dine cookieindstillinger',
            description: '<p>Vælg, hvad du vil sige ja til. Du kan altid ændre dit valg senere via cookie-ikonet nederst til venstre.</p>',
            saveButtonText: 'Gem og luk',
            saveButtonAccessibleLabel: 'Gem dine cookieindstillinger',
            creditLinkText: 'Få dette cookiebanner gratis',
            creditLinkAccessibleLabel: 'Besøg Silktide Consent Manager'
          }
        }
      });
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="utility">ONLINEFORLØB · 100% DISKRET · START NÅR DET PASSER DIG</div>
      <div class="nav wrap">
        <a class="brand" href={u('/')}>Slip din købetrang<small>psykolog Ditte Munch-Andersen</small></a>
        <nav class="nav-links" id="nav-links" aria-label="Primær navigation">
          <a href={`${u('/')}#forloeb`}>Onlineforløbet</a>
          <a href={u('/individuelle-samtaler')}>Individuelle samtaler</a>
          <a href={u('/om-ditte')}>Om Ditte</a>
          <a href={u('/bloggen')}>Blog</a>
          <a href={u('/kontakt')}>Kontakt</a>
        </nav>
        <a class="btn" href={`${u('/')}#forloeb`}>Se forløbet</a>
        <button class="menu-toggle" aria-label="Åbn menu" aria-controls="nav-links" aria-expanded="false">☰</button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div><h3>Slip din købetrang</h3><p>Et online selvstudieforløb om købeafhængighed og overforbrug — udviklet af klinisk psykolog Ditte Munch-Andersen.</p></div>
        <div><h3>Find vej</h3><ul><li><a href={`${u('/')}#forloeb`}>Onlineforløbet</a></li><li><a href={u('/individuelle-samtaler')}>Individuelle samtaler</a></li><li><a href={u('/bloggen')}>Artikler</a></li><li><a href={u('/om-ditte')}>Om Ditte</a></li></ul></div>
        <div><h3>Kontakt</h3><p><a href="mailto:psykolog@dittemunchandersen.dk">psykolog@dittemunchandersen.dk</a></p><p><a href={u('/kontakt')}>Kontakt Ditte</a></p></div>
      </div>
      <div class="wrap footer-bottom">© {new Date().getFullYear()} Ditte Munch-Andersen · <a href={u('/privatlivspolitik')}>Privatlivspolitik</a> · <a href={u('/handelsbetingelser')}>Handelsbetingelser</a></div>
    </footer>
    <script is:inline>
      const button = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#nav-links');
      button?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); button.setAttribute('aria-expanded', String(Boolean(open))); });
    </script>
  </body>
</html>
